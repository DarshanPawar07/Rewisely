DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/reviseme?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
CLIENT_URL=http://localhost:5173
# Production frontend origin used after Google OAuth. Set this on Render.
CLIENT_REDIRECT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Production on Render Free: use the HTTPS API and a sender on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Rewisely <codes@mail.rewisely.online>
# Optional SMTP fallback for local development or hosts that allow outbound SMTP.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
