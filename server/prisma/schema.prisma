generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RevisionStatus {
  SCHEDULED
  PENDING
  COMPLETED
  OVERDUE
  MISSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskCategory {
  STUDY
  DSA
  COLLEGE
  PROJECT
  JOB
  PERSONAL
  OTHER
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum NotificationType {
  REVISION_DUE
  REVISION_OVERDUE
  TASK_DUE
  SYSTEM
}

model User {
  id String @id @default(cuid())
  name String
  firstName String?
  lastName String?
  occupation String?
  phone String?
  email String @unique
  emailVerified Boolean @default(false)
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String? @unique
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt DateTime?
  emailVerificationAttempts Int @default(0)
  emailLoginCodeHash String?
  emailLoginCodeExpiresAt DateTime?
  emailLoginCodeSentAt DateTime?
  emailLoginCodeAttempts Int @default(0)
  passwordHash String
  googleId String? @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings UserSettings?
  subjects Subject[]
  topics Topic[]
  revisions Revision[]
  tasks Task[]
  notifications Notification[]
  weeklyTargets WeeklyTarget[]
}

model WeeklyTarget {
  id String @id @default(cuid())
  userId String
  name String
  weekStart DateTime
  weekEnd DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks WeeklyTargetTask[]
  @@index([userId, weekStart])
}

model WeeklyTargetTask {
  id String @id @default(cuid())
  weeklyTargetId String
  title String
  completed Boolean @default(false)
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  weeklyTarget WeeklyTarget @relation(fields: [weeklyTargetId], references: [id], onDelete: Cascade)
  @@index([weeklyTargetId])
}

model UserSettings {
  id String @id @default(cuid())
  userId String @unique
  timezone String @default("UTC")
  defaultRevisionInterval Int @default(15)
  notificationEnabled Boolean @default(true)
  emailNotificationEnabled Boolean @default(false)
  theme String @default("system")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id String @id @default(cuid())
  userId String
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]
  studyChapters StudyChapter[]
  studySteps StudyStep[]
  @@index([userId])
  @@unique([userId, name])
}

model StudyStep {
  id String @id @default(cuid())
  subjectId String
  name String
  position Int
  colour String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterProgress StudyChapterProgress[]
  @@index([subjectId, active, position])
}

model StudyChapter {
  id String @id @default(cuid())
  subjectId String
  legacyTopicId String? @unique
  title String
  notes String?
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress StudyChapterProgress[]
  @@index([subjectId, title])
}

model StudyChapterProgress {
  id String @id @default(cuid())
  chapterId String
  stepId String
  done Boolean @default(false)
  score Float?
  notes String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter StudyChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  step StudyStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  @@unique([chapterId, stepId])
  @@index([stepId])
}

model Topic {
  id String @id @default(cuid())
  userId String
  subjectId String
  title String
  description String?
  notes String?
  difficulty Difficulty @default(MEDIUM)
  checklist Json?
  mistakes Json?
  resources Json?
  completedStudyAt DateTime?
  plannedRevisionCount Int @default(0)
  revisionGapDays Int?
  reminderEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  revisions Revision[]
  @@index([userId])
  @@index([subjectId])
}

model Revision {
  id String @id @default(cuid())
  userId String
  topicId String
  revisionNumber Int
  scheduledAt DateTime
  completedAt DateTime?
  status RevisionStatus @default(SCHEDULED)
  confidence Int?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@index([userId, scheduledAt])
  @@index([topicId])
  @@index([status])
}

model Task {
  id String @id @default(cuid())
  userId String
  title String
  description String?
  dueDate DateTime?
  priority Priority @default(MEDIUM)
  category TaskCategory @default(OTHER)
  completed Boolean @default(false)
  completedAt DateTime?
  isRecurring Boolean @default(false)
  recurrenceType Recurrence @default(NONE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, dueDate])
  @@index([completed])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}
